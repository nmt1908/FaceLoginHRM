<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera Preview (Base Layer) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Face overlay -->
    <com.example.facelogin2.FaceGraphicOverlay
        android:id="@+id/graphicOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- App Title Bar (Top Overlay) -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#AADEDADA"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New HRM Login"
            android:textSize="34sp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Network Status Bar (bottom-right overlay, horizontal) -->
    <LinearLayout
        android:id="@+id/networkStatusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:background="#66000000"
        android:elevation="12dp">

        <!-- Wi-Fi: SSID -->
        <TextView
            android:id="@+id/tvSsidLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi:"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSsidValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <!-- spacing -->
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Endpoints container: now horizontal -->
        <LinearLayout
            android:id="@+id/endpointStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </LinearLayout>

    <!-- Modern Compose UI (Copied from VG-CAMERA) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeUserInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>

